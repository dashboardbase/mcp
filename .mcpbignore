# The bundle ships node_modules so it runs standalone in Claude Desktop. Drop things
# that are never loaded at runtime. Deliberately conservative: package source dirs are
# kept, because some packages resolve their entry point into src/.
**/*.map
**/*.md
**/*.markdown
node_modules/**/*.ts
node_modules/**/.bin/**
node_modules/**/LICENSE*
node_modules/**/license*
node_modules/**/.github/**
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/__tests__/**
node_modules/.package-lock.json
